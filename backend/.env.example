# ===== 本地后端配置 =====
# 本地存放上传图片与下载的 ply 模型的目录
LOCAL_STORAGE_DIR=./storage
# 是否启用 GPU（convert.py 的 --no_gpu 参数）
USE_GPU=false
# 后端服务端口（Dockerfile 启动、run.py 本地启动、回调 URL 生成都会读取）
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8010

# ===== CORS 跨域配置 =====
# 生产环境必须限定前端域名，不要用 *
# 示例：CORS_ORIGINS=http://localhost:5173,https://your.domain
CORS_ORIGINS=*

# ===== 用户鉴权（不开放注册，仅管理员开号）=====
# JWT 签名密钥，生产环境务必改为足够长的随机串
JWT_SECRET=please-change-this-jwt-secret
# Token 有效期（小时），默认 7 天
JWT_EXPIRE_HOURS=168
# 启动时播种管理员；users.json 里已有同名用户则不覆盖密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ===== 上传配额（防止公网薅 OSS）=====
# 单文件上限（MB）
MAX_FILE_SIZE_MB=20
# 单任务最多图片张数
MAX_IMAGES_PER_TASK=200
# 每用户每天最多任务数
DAILY_TASK_LIMIT=20
# 每用户每天最多上传字节数（默认 2GB）
DAILY_UPLOAD_BYTES=2147483648
# 获取上传凭证：每用户每分钟次数
POLICY_RATE_LIMIT_PER_MIN=10
# Post Policy 有效期（秒）
OSS_POLICY_EXPIRE_SECONDS=900

# ===== Worker（3090 轮询脚本）接入鉴权 =====
# 3090 上的 worker_config.json 中 api_key 必须与此保持一致，否则领取/上报被拒（401）
WORKER_API_KEY=suying-3dgs-worker-2024

# ===== 调试模式 =====
# 设为 true 时，不依赖真实 worker，后端内置模拟 worker 自动跑完流程（便于前端联调）
DEBUG_MODE=false

# ===== 阿里云 OSS（前端直传图片 + Worker 上传 ply）=====
# 留空则前端走本地 multipart 兜底，Worker 从服务器下载图片
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-XXX.aliyuncs.com
# 图片对象名前缀：images/{user_id}/{recon_id}/001.jpg
OSS_IMAGE_PREFIX=images
# 模型对象名前缀：output/{recon_id}/{recon_id}.ply
OSS_OUTPUT_PREFIX=output
# 3090 领取/进度私有队列前缀（对象 ACL=private，不要公共读）
OSS_QUEUE_PREFIX=queue
